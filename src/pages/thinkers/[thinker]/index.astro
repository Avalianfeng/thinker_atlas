---
import Mdx from '@components/Mdx.astro';
import Hall from '@layouts/Hall.astro';
import Portrait from '@components/Portrait.astro';
import Maturity from '@components/Maturity.astro';
import TimelineH from '@components/TimelineH.astro';
import ProvenanceBar from '@components/ProvenanceBar.astro';
import Relation from '@components/Relation.astro';
import { getAtlas, lifespan, yearOf, conceptUrl } from '@lib/atlas';
import { formatDay } from '@lib/git';

export async function getStaticPaths() {
  const atlas = await getAtlas();
  return atlas.thinkers.map((t) => ({ params: { thinker: t.id.replace('atlas:', '') }, props: { thinkerId: t.id } }));
}

const atlas = await getAtlas();
const thinker = atlas.thinker(Astro.props.thinkerId);
const t = thinker.data;
const base = `/thinkers/${Astro.props.thinkerId.replace('atlas:', '')}`;
const years = lifespan(thinker);
const life = atlas.life.get(thinker.id);
const events = life?.data.events ?? [];
const stats = atlas.statsOf(thinker.id);
const relations = atlas.relationsOf(thinker.id);
const updated = atlas.updatedOf(thinker.id);

const rooms = [
  { label: '生平', href: `${base}/life/`, desc: '分期叙述与完整时间线', n: atlas.life.has(thinker.id) ? '01' : '—' },
  { label: '思想', href: `${base}/thought/`, desc: `${atlas.conceptsOf(thinker.id).length} 个概念，按时期分组`, n: '02' },
  { label: '作品', href: `${base}/works/`, desc: `${atlas.worksOf(thinker.id).length} 部作品`, n: '03' },
  { label: '身后', href: `${base}/afterlife/`, desc: '直接继承、学派化、当代回响', n: atlas.afterlife.has(thinker.id) ? '04' : '—' },
  { label: '谱系', href: `${base}/genealogy/`, desc: `${relations.length} 条关系`, n: '05' },
  { label: '学习路径', href: `${base}/path/`, desc: '有序阅读与检查点', n: atlas.paths.has(thinker.id) ? '06' : '—' },
];
const epigraph = t.epigraph;
---
<Hall atlas={atlas} thinker={thinker} title={t.name.zh}>
  <header class="hall-head">
    <Portrait class="portrait" name={t.name.zh} original={t.name.original || t.name.en} years={years} accent={t.accent} src={t.portrait} />
    <div>
      <h1>{t.name.zh}</h1>
      <div class="orig">{t.name.original || t.name.en}</div>
      <div class="facts num">
        <span>{years}</span>
        {t.born.place && <span>{t.born.place}{t.died?.place && t.died.place !== t.born.place ? ` — ${t.died.place}` : ''}</span>}
        <span>{t.fields.join(' · ')}</span>
        <span>加入于 {String(t.added).slice(0, 10)}</span>
      </div>
      {epigraph && (
        <blockquote class="epigraph">
          <p>{epigraph.text}</p>
          {epigraph.original && (
            <details class="orig">
              <summary><span class="sr-only">原文</span></summary>
              <p lang={epigraph.lang || 'de'} class="latin">{epigraph.original}</p>
            </details>
          )}
          <footer class="meta">{epigraph.source}{epigraph.translator ? ` · ${epigraph.translator}` : ''}</footer>
        </blockquote>
      )}
      <div class="stats">
        <Maturity level={t.maturity} />
        <ProvenanceBar stats={stats} />
        {updated && <span class="updated num">最后修改 {formatDay(updated)}</span>}
      </div>
    </div>
    {events.length > 0 && (
      <div class="hall-timeline">
        <TimelineH born={yearOf(t.born.date)!} died={yearOf(t.died?.date)} events={events} accent={t.accent} />
      </div>
    )}
  </header>

  <nav class="rooms" aria-label="展室">
    {rooms.map((r) => (
      <a href={r.href}>
        <span class="n">{r.n}</span><span class="t">{r.label}</span>
        <span class="d">{r.desc}</span>
      </a>
    ))}
  </nav>

  {atlas.conceptsOf(thinker.id).length > 0 && (
    <>
      <h2 class="section-title">思想展室 · 概念一览</h2>
      <div class="card-grid">
        {atlas.conceptsOf(thinker.id).map((c) => (
          <a href={conceptUrl(c.id)}>
            <span class="t">{c.data.title}</span>
            {c.data.original && <span class="o" lang={c.data.lang}>{c.data.original}</span>}
            <div class="d">{c.data.definition}</div>
          </a>
        ))}
      </div>
    </>
  )}

  {relations.length > 0 && (
    <>
      <h2 class="section-title">谱系</h2>
      <div class="relation-list">
        {relations.map((r) => <Relation relation={r} atlas={atlas} compact />)}
      </div>
      <p class="meta"><a href={`${base}/genealogy/`}>这个展厅的完整关系 →</a></p>
    </>
  )}

  <div class="essay">
    <div class="prose">
      <h2>档案</h2>
      <Mdx entry={thinker} />
    </div>
  </div>
</Hall>
