---
import Base from '@layouts/Base.astro';
import Placard from '@components/Placard.astro';
import MultiTimeline from '@components/MultiTimeline.astro';
import { getAtlas, personUrl } from '@lib/atlas';
import { loadMultiLanes } from '@lib/timeline-yml';
import { accentMapForPeople, type AccentPerson } from '@lib/accents';
import { resolvePortrait, personSlug } from '@lib/portrait';

const atlas = await getAtlas();
/** 展厅墙默认按出生年排；无出生年靠后，同岁按 name 稳定排 */
const byBorn = [...atlas.people].sort((a, b) => {
  const ba = String(a.data.born ?? '');
  const bb = String(b.data.born ?? '');
  if (!ba && !bb) return String(a.data.name).localeCompare(String(b.data.name), 'zh');
  if (!ba) return 1;
  if (!bb) return -1;
  const cmp = ba.localeCompare(bb);
  return cmp !== 0 ? cmp : String(a.data.name).localeCompare(String(b.data.name), 'zh');
});
const accentPeople: AccentPerson[] = atlas.people.map((p) => ({
  id: p.id,
  name: p.data.name,
  born: p.data.born ? String(p.data.born) : undefined,
}));
const accentById = accentMapForPeople(accentPeople);
const multiLanes = loadMultiLanes(
  atlas.people.map((p) => ({
    id: p.id,
    name: p.data.name,
    order: p.data.order,
    accent: accentById.get(p.id)!,
    born: p.data.born ? String(p.data.born) : undefined,
    died: p.data.died ? String(p.data.died) : undefined,
  })),
);

/** 首页沙龙挂墙：按出生年，带解析后的 src */
const wallTiles = byBorn.map((p) => {
  const slug = personSlug(p.id);
  const t = p.data;
  return {
    id: p.id,
    name: t.name as string,
    nameEn: (t.name_en as string) || '',
    url: personUrl(p.id),
    src: resolvePortrait(slug, t.portrait as string | undefined) || '',
    accent: accentById.get(p.id)!,
    initial: ((t.name_en as string) || (t.name as string)).trim().charAt(0),
  };
});
---
<Base title="展厅墙" description="私人思想展馆">
  <script is:inline>
    (() => {
      const v = localStorage.getItem('atlas:wall-view');
      document.documentElement.dataset.wallView = v === 'cards' ? 'cards' : 'detail';
    })();
  </script>
  <div class="page">
    <section class="wall-hero" aria-label="肖像墙">
      {/*
        沙龙挂墙：槽位固定（主大 + 侧翼小重叠），JS 只轮换主位内容。
        人物数据挂在 data-hero-wall 上供轮播读取。
      */}
      <div
        class="salon-hang"
        data-hero-wall
        data-tiles={JSON.stringify(
          wallTiles.map((t) => ({
            name: t.name,
            url: t.url,
            src: t.src,
            accent: t.accent,
            initial: t.initial,
          })),
        )}
      >
        {wallTiles.length > 0 && (
          <a
            class="salon-frame salon-frame--main is-active"
            href={wallTiles[0].url}
            style={`--accent:${wallTiles[0].accent}`}
            data-slot="main"
            aria-label={wallTiles[0].name}
          >
            <span class="salon-mat">
              <img
                class="salon-img"
                src={wallTiles[0].src || undefined}
                alt=""
                width="200"
                height="267"
                loading="eager"
                hidden={!wallTiles[0].src}
              />
              <span class="salon-fallback" aria-hidden="true" hidden={!!wallTiles[0].src}>{wallTiles[0].initial}</span>
            </span>
            <span class="salon-tombstone">{wallTiles[0].name}</span>
          </a>
        )}
        {wallTiles.length > 1 && (
          <a
            class="salon-frame salon-frame--wing"
            href={wallTiles[1].url}
            style={`--accent:${wallTiles[1].accent}`}
            data-slot="wing"
            data-wing="0"
            aria-label={wallTiles[1].name}
          >
            <span class="salon-mat">
              <img
                class="salon-img"
                src={wallTiles[1].src || undefined}
                alt=""
                width="140"
                height="187"
                loading="lazy"
                hidden={!wallTiles[1].src}
              />
              <span class="salon-fallback" aria-hidden="true" hidden={!!wallTiles[1].src}>{wallTiles[1].initial}</span>
            </span>
            <span class="salon-tombstone">{wallTiles[1].name}</span>
          </a>
        )}
        {wallTiles.length > 2 && (
          <a
            class="salon-frame salon-frame--wing salon-frame--wing-2"
            href={wallTiles[2].url}
            style={`--accent:${wallTiles[2].accent}`}
            data-slot="wing"
            data-wing="1"
            aria-label={wallTiles[2].name}
          >
            <span class="salon-mat">
              <img
                class="salon-img"
                src={wallTiles[2].src || undefined}
                alt=""
                width="120"
                height="160"
                loading="lazy"
                hidden={!wallTiles[2].src}
              />
              <span class="salon-fallback" aria-hidden="true" hidden={!!wallTiles[2].src}>{wallTiles[2].initial}</span>
            </span>
            <span class="salon-tombstone">{wallTiles[2].name}</span>
          </a>
        )}
      </div>
    </section>

    <div class="view-switch">
      <button type="button" class="view-btn" id="tg-wall-view" aria-label="切换到卡片">卡片</button>
    </div>

    <section class="wall" aria-label="人物展牌">
      {byBorn.map((p, i) => (
        <Placard
          person={p}
          index={i}
          allPeople={accentPeople}
          accent={accentById.get(p.id)}
        />
      ))}
    </section>

    <script is:inline>
      (() => {
        if (document.documentElement.dataset.wallView === 'cards') {
          document.querySelector('.wall')?.classList.add('wall--cards');
        }
      })();
    </script>

    {multiLanes.length > 0 && (
      <section class="home-multi" aria-label="多人时间线">
        <h2 class="section-title">多人时间线</h2>
        <MultiTimeline lanes={multiLanes} />
      </section>
    )}
  </div>
</Base>

<style>
  /* 展馆 lobby：重叠拼贴 / 沙龙挂墙（非第二排卡片） */
  .wall-hero {
    padding: calc(var(--u) * 3) 0 calc(var(--u) * 5);
    border-bottom: 1px solid var(--rule);
    margin-bottom: calc(var(--u) * 4);
  }
  .salon-hang {
    position: relative;
    width: min(100%, 380px);
    height: clamp(210px, 34vw, 260px);
    margin: 0;
  }
  .salon-frame {
    --accent: var(--ink-2);
    position: absolute;
    display: block;
    text-decoration: none;
    color: inherit;
    z-index: 1;
  }
  /* 主框：缩小后的挂墙主位 */
  .salon-frame--main {
    width: min(48%, 168px);
    left: 8%;
    top: 6%;
    z-index: 3;
    transform: rotate(-1.5deg);
  }
  /* 侧翼：略小、重叠、2–4° 倾 */
  .salon-frame--wing {
    width: min(34%, 118px);
    left: 46%;
    top: 18%;
    z-index: 2;
    transform: rotate(3.2deg);
  }
  .salon-frame--wing-2 {
    left: 62%;
    top: 8%;
    width: min(30%, 104px);
    transform: rotate(-2.8deg);
    z-index: 1;
  }
  .salon-mat {
    display: block;
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: 7px 7px 18px;
    box-shadow:
      0 1px 0 rgba(31, 29, 26, 0.04),
      0 8px 22px rgba(31, 29, 26, 0.1);
  }
  [data-theme='dark'] .salon-mat {
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.2),
      0 8px 22px rgba(0, 0, 0, 0.35);
  }
  .salon-img,
  .salon-fallback {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    background: var(--paper-2);
  }
  .salon-img {
    transition: opacity 0.85s ease;
  }
  .salon-frame.is-fading .salon-img {
    opacity: 0.25;
  }
  .salon-fallback {
    display: grid;
    place-items: center;
    font-family: var(--font-latin);
    font-size: 2.2rem;
    color: color-mix(in srgb, var(--accent) 70%, var(--ink));
    background: color-mix(in srgb, var(--accent) 16%, var(--paper-2));
    opacity: 0.9;
  }
  /* tombstone：悬停 / 主位常显极短中文名 */
  .salon-tombstone {
    position: absolute;
    left: 50%;
    bottom: -1.35em;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--fs-tiny);
    color: var(--ink-2);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur) ease;
  }
  .salon-frame--main .salon-tombstone,
  .salon-frame:hover .salon-tombstone,
  .salon-frame:focus-visible .salon-tombstone {
    opacity: 1;
  }
  .salon-frame:focus-visible {
    outline: 2px solid var(--ink-2);
    outline-offset: 4px;
  }
  .salon-frame:hover {
    z-index: 5;
  }
  @media (max-width: 480px) {
    .salon-hang {
      height: 200px;
      width: 100%;
    }
    .salon-frame--main {
      width: 44%;
      left: 4%;
    }
    .salon-frame--wing {
      width: 32%;
      left: 48%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .salon-img {
      transition: none;
    }
    .salon-tombstone {
      opacity: 1;
    }
  }
  .home-multi {
    margin-top: calc(var(--u) * 8);
    padding-top: calc(var(--u) * 4);
    border-top: 1px solid var(--rule);
  }
</style>
