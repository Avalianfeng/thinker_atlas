---
import { scale, tickYears, BANDS } from '../lib/timeline';
import { thinkerUrl, yearOf } from '../lib/atlas';
interface Props {
  lanes: { thinker: any; events: { date: string; kind: string; title: string }[] }[];
}
const { lanes } = Astro.props;
const W = 960;
const padL = 120;
const padR = 24;
const laneH = 76;
const top = 64;
const H = top + laneH * lanes.length + 30;
const allYears = [
  ...lanes.flatMap((l) => [yearOf(l.thinker.data.born.date)!, yearOf(l.thinker.data.died?.date) ?? 2000]),
  ...BANDS.flatMap((b) => [b.from, b.to]),
];
const from = Math.min(...allYears) - 4;
const to = Math.max(...allYears, 2026) + 2;
const x = scale(from, to, padL, W - padR);
const ticks = tickYears(from, to, 10);
---
<svg class="mtl" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="多人并置时间线，叠加历史背景">
  {BANDS.map((b) => (
    <g>
      <rect class="band" x={x(b.from)} y="24" width={Math.max(3, x(b.to) - x(b.from))} height={H - 48} />
      <text class="band-label" x={(x(b.from) + x(b.to)) / 2} y="18" text-anchor="middle">{b.label}</text>
    </g>
  ))}
  <line class="axis" x1={padL} y1={H - 24} x2={W - padR} y2={H - 24} />
  {ticks.map((y) => (
    <text x={x(y)} y={H - 8} text-anchor="middle">{y}</text>
  ))}
  {lanes.map((l, i) => {
    const cy = top + i * laneH + laneH / 2;
    const born = yearOf(l.thinker.data.born.date)!;
    const died = yearOf(l.thinker.data.died?.date) ?? 2026;
    return (
      <g>
        <a href={thinkerUrl(l.thinker.id)}>
          <text class="lane-name" x={padL - 12} y={cy + 4} text-anchor="end">{l.thinker.data.name.zh}</text>
        </a>
        <line class="lane-line" x1={x(born)} y1={cy} x2={x(died)} y2={cy} stroke={l.thinker.data.accent} stroke-width="2.5" />
        {l.events
          .filter((e) => e.kind !== '生活')
          .map((e) => {
            const y = Number(e.date.slice(0, 4));
            return (
              <g>
                <title>{`${e.date} ${e.title}`}</title>
                <circle class="ev" cx={x(y)} cy={cy} r="3" fill={e.kind === '历史背景' ? 'var(--paper)' : l.thinker.data.accent} />
              </g>
            );
          })}
      </g>
    );
  })}
</svg>
