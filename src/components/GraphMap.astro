---
import { scale } from '@lib/timeline';
import { yearOf, thinkerUrl } from '@lib/atlas';

interface Props {
  thinkers: any[];
  relations: any[];
  atlas: any;
  mini?: boolean;
  highlight?: string;
}

const { thinkers, relations, mini = false, highlight } = Astro.props;

const W = mini ? 820 : 960;
const padL = mini ? 116 : 158;
const padR = mini ? 26 : 40;
const laneH = mini ? 42 : 72;
const top = mini ? 22 : 34;
const H = top + laneH * Math.max(1, thinkers.length - 1) + (mini ? 38 : 54);

const birth = (t: any) => yearOf(t.data.born.date)!;
const death = (t: any) => yearOf(t.data.died?.date) ?? new Date().getFullYear();
const from = Math.min(...thinkers.map(birth)) - 4;
const to = Math.max(...thinkers.map(death)) + 4;
const x = scale(from, to, padL, W - padR);

const thinkerOf = (id: string) => `atlas:${id.replace(/^atlas:/, '').split('/')[0]}`;
const laneIndex = (id: string) => thinkers.findIndex((t) => t.id === thinkerOf(id));
const laneY = (i: number) => top + Math.max(0, i) * laneH + 16;
const axisY = H - (mini ? 20 : 28);

// 关系的锚点：起点用关系起始年（缺省用该人物的出生年）；终点错开若干年，让箭头读得出方向。
const anchorYear = (id: string, since: number | undefined, offset: number) => {
  const i = laneIndex(id);
  const base = since ?? (i >= 0 ? birth(thinkers[i]) : from);
  return base + offset;
};

const edges = relations
  .map((r: any, idx: number) => {
    const ia = laneIndex(r.data.from);
    const ib = laneIndex(r.data.to);
    if (ia < 0 || ib < 0) return null;
    const spread = r.data.type === '平行' || !r.data.directed ? 4 + (idx % 3) * 6 : 12;
    const ya = laneY(ia);
    const yb = laneY(ib);
    const rawA = x(anchorYear(r.data.from, r.data.since, 0));
    const rawB = x(anchorYear(r.data.to, r.data.since, spread));
    // 缩略图：拉成垂直连线，免得斜线被误读成某人的生命周期
    const xa = mini ? (rawA + rawB) / 2 : rawA;
    const xb = mini ? (rawA + rawB) / 2 : rawB;
    const y1 = ya - 6;
    const y2 = yb - 6;
    const mx = (xa + xb) / 2 + (idx % 2 ? 26 : -26);
    const d = mini ? `M${xa} ${y1} L${xb} ${y2}` : `M${xa} ${y1} C${mx} ${y1}, ${mx} ${y2}, ${xb} ${y2}`;
    return {
      d,
      type: r.data.type,
      verified: r.data.verified,
      id: r.data.id,
      xa, xb, y1, y2,
      mx,
      my: (y1 + y2) / 2,
      dim: highlight ? ![ia, ib].includes(laneIndex(highlight)) : false,
    };
  })
  .filter(Boolean) as any[];

const ticks = 8;
---
<svg class:list={['graph', { mini }]} viewBox={`0 0 ${W} ${H}`} role="img" aria-label="人物谱系图：横轴为年代，纵轴为人物，线型区分关系类型">
  <defs>
    <marker id={mini ? 'arrow-mini' : 'arrow'} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path class="arrowhead" d="M0 0 L10 5 L0 10 z" />
    </marker>
  </defs>

  <line class="axis" x1={padL - 10} y1={axisY} x2={W - padR + 10} y2={axisY} />
  {Array.from({ length: ticks + 1 }, (_, i) => {
    const y = Math.round(from + ((to - from) / ticks) * i);
    return (
      <g>
        <line class="axis" x1={x(y)} y1={axisY - 4} x2={x(y)} y2={axisY + 4} />
        <text x={x(y)} y={axisY + (mini ? 15 : 19)} text-anchor="middle">{y}</text>
      </g>
    );
  })}

  {thinkers.map((t, i) => {
    const y = laneY(i);
    const dim = highlight ? t.id !== highlight : false;
    return (
      <g class={dim ? 'dim' : undefined}>
        <line class="life-line" x1={x(birth(t))} y1={y - 6} x2={x(death(t))} y2={y - 6} stroke={t.data.accent} />
        <a href={thinkerUrl(t.id)}>
          <circle cx={x(birth(t))} cy={y - 6} r={mini ? 3.5 : 4.5} fill={t.data.accent} />
          <text class="node-name" x={padL - 14} y={y + 4} text-anchor="end">{t.data.name.zh}</text>
          {!mini && <text class="node-years" x={padL - 14} y={y + 19} text-anchor="end">{`${birth(t)}—${yearOf(t.data.died?.date) ?? ''}`}</text>}
        </a>
      </g>
    );
  })}

  {edges.map((e) => (
    <path
      class:list={['edge', `t-${e.type}`, { unverified: !e.verified, dim: e.dim }]}
      d={e.d}
      marker-end={`url(#${mini ? 'arrow-mini' : 'arrow'})`}
      marker-start={relations.find((r: any) => r.data.id === e.id)?.data.directed === false ? `url(#${mini ? 'arrow-mini' : 'arrow'})` : undefined}
    >
      <title>{`${e.type}（${e.id}${e.verified ? '' : '，待核实'}）`}</title>
    </path>
  ))}

  {!mini &&
    edges.map((e) =>
      e.dim ? null : (
        <text class="edge-label" x={e.mx} y={e.my + 3} text-anchor="middle">
          {e.type}
          {!e.verified && <tspan> ·待核</tspan>}
        </text>
      ),
    )}
</svg>
