---
import Hall from '@layouts/Hall.astro';
import Maturity from '@components/Maturity.astro';
import { getAtlas, conceptUrl, thinkerUrl } from '@lib/atlas';

export async function getStaticPaths() {
  const atlas = await getAtlas();
  return atlas.thinkers
    .filter((t) => atlas.conceptsOf(t.id).length > 0)
    .map((t) => ({ params: { thinker: t.id.replace('atlas:', '') }, props: { thinkerId: t.id } }));
}

const atlas = await getAtlas();
const thinker = atlas.thinker(Astro.props.thinkerId);
const concepts = atlas.conceptsOf(thinker.id);
const periods = thinker.data.periods;
const groups = periods.map((p) => ({ ...p, items: concepts.filter((c) => c.data.period === p.id) }));
const unperioded = concepts.filter((c) => !c.data.period);
const stats = atlas.statsOf(thinker.id);
---
<Hall atlas={atlas} thinker={thinker} title="思想">
  <h1>思想</h1>
  <p class="lede">
    {concepts.length} 个概念，按时期分组并置。每一篇都是「概念卡 → 长文 → 演变 → 对话者 → 我的批注」的结构；先看卡，再进文。
  </p>

  <div class="period-groups" style="margin-top:calc(var(--u)*4)">
    {groups.map((g) => (
      <section>
        <h3>{g.label}<span class="year num">{g.from}—{g.to}</span></h3>
        <div class="card-grid">
          {g.items.map((c) => (
            <a href={conceptUrl(c.id)}>
              <span class="t">{c.data.title}</span>
              {c.data.original && <span class="o" lang={c.data.lang}>{c.data.original}</span>}
              <div class="d">{c.data.definition}</div>
            </a>
          ))}
          {g.items.length === 0 && <p class="meta" style="padding:var(--u)">这一期还没有概念稿。</p>}
        </div>
      </section>
    ))}
    {unperioded.length > 0 && (
      <section>
        <h3>未分期</h3>
        <div class="card-grid">
          {unperioded.map((c) => (
            <a href={conceptUrl(c.id)}>
              <span class="t">{c.data.title}</span>
              <div class="d">{c.data.definition}</div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <h2 class="section-title">已加入人物中的相关概念</h2>
  <ul class="listing">
    {atlas.thinkers
      .filter((o) => o.id !== thinker.id)
      .flatMap((o) => atlas.conceptsOf(o.id).map((c) => ({ o, c })))
      .map(({ o, c }) => (
        <li>
          <a href={conceptUrl(c.id)}>{c.data.title}</a>
          <span class="meta">{o.data.name.zh} · {c.data.definition.slice(0, 28)}…</span>
        </li>
      ))}
  </ul>
  <p><a href={thinkerUrl(thinker.id)}>← 回到展厅</a></p>
</Hall>

<style>
  .lede {
    font-size: 20px;
    max-width: 680px;
  }
</style>
