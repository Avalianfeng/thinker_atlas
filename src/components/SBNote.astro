---
import { getCollection, render } from 'astro:content';
import { sbPageUrl } from '../lib/env';

interface Props {
  page: string;
  from?: 'own' | 'own-discussed';
}
const { page, from = 'own' } = Astro.props;
const key = page.replace(/\.md$/, '');
const notes = await getCollection('sbnotes');
const note = notes.find((n) => n.data.page === key || n.id === key);
const url = sbPageUrl(key);
const Content = note ? (await render(note)).Content : null;
---
{note && Content ? (
  <div class="block sbnote" data-from={from}>
    {url ? <a class="sb-mark" href={url}>笔记</a> : <span class="sb-mark" tabindex="0" data-source={`SilverBullet：${key}`}>笔记</span>}
    <Content />
  </div>
) : (
  <div class="todo">
    嵌入的 SilverBullet 笔记 <code>{key}</code> 尚未同步到本地缓存。运行 <code>npm run sync</code> 后再构建。
  </div>
)}
