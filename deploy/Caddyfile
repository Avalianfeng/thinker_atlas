# Thinker's Atlas · Caddy 配置片段（v2）
#
# 站点整体私有：网页走 basic auth；/api/ 另外配只读 Bearer token（按路径区分，可单独吊销）；
# 全站 noindex。把 <> 里的值换成你的。
#
# 密码哈希用：caddy hash-password --plaintext '你的密码'
# token 建议用随机长串：openssl rand -hex 32

{
	# 不收集访问日志里的敏感路径；如需排障再打开
	servers {
		trusted_proxies static private_ranges
	}
}

atlas.example.com {
	root * /var/www/atlas
	encode zstd gzip

	# ---- 全站 noindex ----
	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		# 私有站也关闭 iframe 嵌入
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# ---- 只读 API：Bearer token ----
	# 先匹配 /api/*，用 Authorization 头校验；未带或错误返回 401，不落到 basic auth。
	@api path /api/* /api
	handle @api {
		# 只允许 GET/HEAD
		@notRead method POST PUT PATCH DELETE
		respond @notRead "read-only api" 405

		# CORS：只给白名单站点
		header {
			Access-Control-Allow-Origin "https://your-other-site.example"
			Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
			Vary "Origin"
			Cache-Control "public, max-age=300"
		}
		@options method OPTIONS
		respond @options 204

		# Bearer token：换掉 <API_TOKEN>；轮换时同时改这里并 reload
		@badAuth not header Authorization "Bearer <API_TOKEN>"
		respond @badAuth "unauthorized" 401 {
			close
		}

		file_server
	}

	# ---- 网页：basic auth ----
	handle {
		basic_auth {
			# 用户名 + 密码哈希：caddy hash-password --plaintext '...'
			aeris <BCRYPT_HASH>
		}
		# 静态文件；目录索引与 404
		try_files {path} {path}/ {path}/index.html
		file_server {
			precompressed zstd gzip
		}
		# 页面不缓存，避免改完看不到
		header Cache-Control "private, no-store"
	}

	# 字体与静态资源可以长缓存
	@assets path /fonts/* /_astro/* /pagefind/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# ---- 安全响应头 ----
	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
	}

	log {
		output file /var/log/caddy/atlas.log {
			roll_size 10MiB
			roll_keep 5
		}
		# 不要把 Authorization 头写进日志
		format console
	}
}

# 可选：给另一台机器做 rsync 目标时，单独一个只写 ssh 用户，
# 不要把 Caddy 或站点的 shell 权限交出去。
