---
import Base from '@layouts/Base.astro';
import Placard from '@components/Placard.astro';
import { getAtlas } from '@lib/atlas';

const atlas = await getAtlas();
---
<Base title="人物">
  <div class="page">
    <h1>人物</h1>
    <p class="lede">按加入顺序排列。成熟度如实显示：种子只写了几条，成形才有完整的关系与作品。</p>
    <div class="wall">
      {atlas.thinkers.map((t, i) => (
        <div class="cell"><Placard thinker={t} index={i} /></div>
      ))}
    </div>
    <h2 class="section-title">按加入时间</h2>
    <ul class="listing">
      {atlas.thinkers.map((t) => (
        <li>
          <a href={`/thinkers/${t.id.replace('atlas:', '')}/`}>{t.data.name.zh}</a>
          <span class="meta">{t.data.name.original || t.data.name.en}</span>
          <span class="meta num">{String(t.data.added).slice(0, 10)}</span>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .lede {
    font-size: 20px;
    max-width: 640px;
  }
  .cell {
    flex: 0 0 calc((100% - var(--u) * 9) / 4);
    min-width: 220px;
    display: flex;
    margin-bottom: calc(var(--u) * 3);
  }
  .cell :global(.placard) {
    flex: 1;
  }
  @media (max-width: 1199px) {
    .cell {
      flex-basis: calc((100% - var(--u) * 3) / 2);
    }
  }
  @media (max-width: 560px) {
    .cell {
      flex-basis: 100%;
    }
  }
</style>
