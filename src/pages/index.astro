---
import Base from '@layouts/Base.astro';
import Placard from '@components/Placard.astro';
import MultiTimeline from '@components/MultiTimeline.astro';
import { getAtlas, entityForFile, personUrl } from '@lib/atlas';
import { recentCommits, formatDay } from '@lib/git';
import { loadMultiLanes } from '@lib/timeline-yml';
import { personAccent } from '@lib/accents';

const atlas = await getAtlas();
/** 展厅墙默认按出生年排；无出生年靠后，同岁按 name 稳定排 */
const byBorn = [...atlas.people].sort((a, b) => {
  const ba = String(a.data.born ?? '');
  const bb = String(b.data.born ?? '');
  if (!ba && !bb) return String(a.data.name).localeCompare(String(b.data.name), 'zh');
  if (!ba) return 1;
  if (!bb) return -1;
  const cmp = ba.localeCompare(bb);
  return cmp !== 0 ? cmp : String(a.data.name).localeCompare(String(b.data.name), 'zh');
});
const multiLanes = loadMultiLanes(
  atlas.people.map((p) => ({
    id: p.id,
    name: p.data.name,
    order: p.data.order,
    accent: personAccent({ order: p.data.order, id: p.id }),
    born: p.data.born ? String(p.data.born) : undefined,
    died: p.data.died ? String(p.data.died) : undefined,
  })),
);

const recent = recentCommits(40)
  .flatMap((c) => c.files.map((f) => ({ file: f, date: c.date, subject: c.subject })))
  .map((r) => ({ ...r, entity: entityForFile(atlas, r.file) }))
  .filter((r) => r.entity)
  .filter((r, i, arr) => arr.findIndex((x) => x.entity!.id === r.entity!.id) === i)
  .slice(0, 6);
---
<Base title="展厅墙" description="私人思想展馆：一人一夹，标准 Markdown">
  <script is:inline>
    (() => {
      const v = localStorage.getItem('atlas:wall-view');
      document.documentElement.dataset.wallView = v === 'cards' ? 'cards' : 'detail';
    })();
  </script>
  <div class="page">
    <section class="wall-hero">
      <h1>思想的展厅</h1>
      <p class="lede">
        每个人物是一间展厅。内容在 git 的 <code>content/people/</code>，标准 Markdown，独立构建。
      </p>
      <p class="meta">目前 {atlas.people.length} 位人物 · {atlas.pieces.length} 篇正文</p>
    </section>

    <div class="view-switch" role="group" aria-label="视图">
      <span class="view-switch-label">视图</span>
      <button type="button" class="view-btn" data-wall-view="detail" aria-pressed="true">详牌</button>
      <button type="button" class="view-btn" data-wall-view="cards" aria-pressed="false">卡片</button>
    </div>

    <section class="wall" aria-label="人物展牌">
      {byBorn.map((p, i) => (
        <Placard person={p} index={i} />
      ))}
    </section>

    <div class="home-cols">
      <section>
        <h2 class="section-title">最近修改</h2>
        <ul class="listing">
          {recent.map((r) => (
            <li>
              <a href={r.entity!.url}>{r.entity!.title}</a>
              <span class="meta num">{formatDay(r.date)}</span>
            </li>
          ))}
          {recent.length === 0 && <li class="meta">暂无提交记录。</li>}
        </ul>
      </section>
      <section>
        <h2 class="section-title">从这里开始</h2>
        <ul class="listing">
          <li><a href={personUrl('wittgenstein')}>维特根斯坦</a><span class="meta">样例展厅</span></li>
          <li><a href={personUrl('russell')}>罗素</a><span class="meta">多人线样例</span></li>
        </ul>
      </section>
    </div>

    {multiLanes.length > 0 && (
      <section class="home-multi" aria-label="多人时间线">
        <h2 class="section-title">多人时间线</h2>
        <p class="meta mtl-lede">各人一条线（生于—卒年，冷色分行）；只显示标了 multi 的事件。事件类型用形状区分。短标题同行避让；悬停或点击看全文与时年；点空白或 Esc 关闭。可横向拖动。标记不跳转。</p>
        <MultiTimeline lanes={multiLanes} />
      </section>
    )}
  </div>
</Base>

<style>
  .wall-hero {
    padding: calc(var(--u) * 4) 0 calc(var(--u) * 5);
    border-bottom: 1px solid var(--rule);
    margin-bottom: calc(var(--u) * 4);
  }
  .wall-hero h1 {
    font-size: 40px;
    letter-spacing: 0.06em;
  }
  .lede {
    font-size: 20px;
    max-width: 640px;
    line-height: 1.8;
  }
  .home-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gutter);
    margin-top: calc(var(--u) * 6);
  }
  @media (max-width: 767px) {
    .home-cols {
      grid-template-columns: 1fr;
    }
  }
  .home-multi {
    margin-top: calc(var(--u) * 8);
    padding-top: calc(var(--u) * 4);
    border-top: 1px solid var(--rule);
  }
  .mtl-lede {
    margin: 0 0 calc(var(--u) * 2);
    max-width: 40rem;
  }
</style>
