---
import Base from '../layouts/Base.astro';
import { listPeople } from '../lib/atlas';
import { scale, decadeTicks } from '../lib/scale';
import path from 'node:path';

const people = await listPeople(path.join(process.cwd(), 'atlas'));
const now = new Date().getFullYear();

// 只画填了出生年的人
const dated = people.filter((p) => p.born);
const years = dated.flatMap((p) => [p.born!, p.died ?? now]);

const W = 860;
const padL = 210;
const padR = 64;
const rowH = 44;
const top = 18;
const H = top + Math.max(1, dated.length) * rowH + 40;

const from = years.length ? Math.min(...years) : now - 100;
const to = years.length ? Math.max(...years) : now;
const x = scale([from - 2, to + 2], [padL, W - padR]);
const ticks = decadeTicks(from - 2, to + 2);
const axisY = top + Math.max(1, dated.length) * rowH + 4;
---
<Base title="时间线">
  <h1 class="page-title">时间线</h1>

  {dated.length > 0 ? (
    <svg class="timeline" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="各人物的生卒年">
      <line class="axis" x1={padL} y1={axisY} x2={W - padR} y2={axisY} />
      {ticks.map((y) => (
        <g>
          <line class="tick" x1={x(y)} y1={axisY} x2={x(y)} y2={axisY + 4} />
          <text class="year" x={x(y)} y={axisY + 22} text-anchor="middle">{y}</text>
        </g>
      ))}

      {dated.map((p, i) => {
        const y = top + i * rowH + rowH / 2;
        const start = x(p.born!);
        const end = x(p.died ?? now);
        return (
          <g>
            <a href={`/people/${encodeURIComponent(p.folder)}/`}>
              <text class="name" x={padL - 20} y={y + 5} text-anchor="end">{p.name}</text>
            </a>
            <line class="life" x1={start} y1={y} x2={end} y2={y} />
            <circle class="dot" cx={start} cy={y} r="2.2" />
            {p.died && <circle class="dot" cx={end} cy={y} r="2.2" />}
            <text class="span" x={end + 12} y={y + 4}>{p.died ? `—${p.died}` : '—'}</text>
          </g>
        );
      })}
    </svg>
  ) : (
    <p class="empty">_meta.md 里还没有填年份。</p>
  )}
</Base>
