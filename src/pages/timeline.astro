---
import Base from '@layouts/Base.astro';
import MultiTimeline from '@components/MultiTimeline.astro';
import { getAtlas } from '@lib/atlas';

const atlas = await getAtlas();
const lanes = atlas.thinkers.map((t) => ({ thinker: t, events: atlas.life.get(t.id)?.data.events ?? [] }));
const allKinds = ['生活', '写作', '出版', '相遇', '历史背景'];
---
<Base title="总时间线">
  <div class="page">
    <h1>总时间线</h1>
    <p class="lede">
      多人并置的泳道，叠加历史背景带（一战、魏玛、二战、1968）。同一时代的人在同一段阴影里写作——这是单人物页面看不出来的东西。
    </p>

    <div class="graph-wrap">
      <MultiTimeline lanes={lanes} />
    </div>

    <h2 class="section-title">按人物看详细时间线</h2>
    <ul class="listing">
      {lanes.map((l) => (
        <li>
          <a href={`/thinkers/${l.thinker.id.replace('atlas:', '')}/life/`}>{l.thinker.data.name.zh}</a>
          <span class="meta">{l.events.length} 个事件</span>
          <span class="meta num">{l.events.filter((e) => e.kind !== '历史背景').length} 条个人经历</span>
        </li>
      ))}
    </ul>
    <p class="meta">事件分类：{allKinds.join('、')}。背景事件在图中不着色，只在人物泳道上以空心点标出。</p>
  </div>
</Base>

<style>
  .lede {
    font-size: 20px;
    max-width: 720px;
  }
  .graph-wrap {
    border: 1px solid var(--rule);
    padding: calc(var(--u) * 2);
    margin: calc(var(--u) * 4) 0;
    overflow-x: auto;
  }
</style>
