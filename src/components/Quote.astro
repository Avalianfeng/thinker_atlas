---
import type { Provenance } from '../lib/provenance';
interface Props {
  original?: string;
  lang?: string;
  source: string;
  translator?: string;
  /** 维特根斯坦式编号，如 5.6、§43；生成锚点 #p-5.6 */
  prop?: string;
  from?: Provenance;
  collapsed?: boolean;
}
const { original, lang = 'de', source, translator, prop, from = 'quote', collapsed = false } = Astro.props;
const provisional = translator && /暂译|待核/.test(translator);
const anchor = prop ? `p-${prop.replace(/^§/, 's')}` : undefined;
---
<figure class="quote block" data-from={from} id={anchor}>
  <span class="ptag" tabindex="0" data-source={source}>{from === 'transcribed' ? '转写' : '原文引文'}</span>
  {prop && <a class="prop-num" href={`#${anchor}`}>{prop}</a>}
  <blockquote class="zh"><slot /></blockquote>
  {original && (
    <details class="orig" open={!collapsed}>
      <summary><span class="sr-only">原文</span></summary>
      <p lang={lang}>{original}</p>
    </details>
  )}
  <figcaption class="src-line">
    {source}{translator && <> · <span class={provisional ? 'provisional' : ''}>{translator}</span></>}
  </figcaption>
</figure>
