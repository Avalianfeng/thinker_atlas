---
import Base from '@layouts/Base.astro';
import { getAtlas, journalRefs } from '@lib/atlas';

const atlas = await getAtlas();
const entries = [...atlas.journal].sort((a, b) => String(b.data.date ?? '').localeCompare(String(a.data.date ?? '')));
---
<Base title="随笔">
  <div class="page">
    <h1>随笔</h1>
    <p class="lede">
      <code>content/journal/</code> 里的本地思考随笔（可选）。结构化正文请写在人物展厅；这里只存过程草稿。Atlas 独立运行，不再与外部笔记应用双向同步。
    </p>
    <ul class="listing journal">
      {entries.map((j) => (
        <li>
          <a href={`/journal/${j.id}/`}>{j.data.title || j.id}</a>
          <span class="meta num">{j.data.date ?? ''}</span>
          <span class="meta">
            {journalRefs(j).map((r) => (atlas.entities.has(r) ? atlas.ref(r).title : r)).join('、')}
          </span>
        </li>
      ))}
      {entries.length === 0 && <li class="meta">还没有随笔。直接在 <code>content/journal/</code> 新建 Markdown 即可。</li>}
    </ul>
  </div>
</Base>
