{
  "name": "thinker-atlas",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "astro": "^7.4.4",
    "dotenv": "^18.0.9",
    "js-yaml": "^5.5.0",
    "pinyin-pro": "^3.29.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.6",
    "pagefind": "^1.5.2",
    "playwright-core": "^1.64.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "astro dev",
    "predev": "node scripts/sync-portraits.mjs",
    "build": "astro build && pagefind --site dist --force-language zh --exclude-selectors \"script,style,.no-index\" && node scripts/check-api.mjs",
    "prebuild": "node scripts/sync-portraits.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "new": "node scripts/new-thinker.mjs",
    "sync": "node scripts/sync.mjs",
    "deploy": "node scripts/deploy.mjs",
    "publish": "npm run build && npm run deploy",
    "check": "astro check",
    "sync:portraits": "node scripts/sync-portraits.mjs"
  }
}
