---
import { KIND_LABEL, formatEventWhen, type TimelineEvent } from '@lib/timeline-yml';

interface Props {
  events: TimelineEvent[];
  accent?: string;
}
const { events, accent } = Astro.props;
const sorted = [...events].sort((a, b) => a.date.localeCompare(b.date));
---
{sorted.length > 0 ? (
  <ol class="timeline-v" style={accent ? `--accent:${accent}` : undefined}>
    {sorted.map((e) => (
      <li class={`k-${e.kind}`}>
        <div class="when num">{formatEventWhen(e)}</div>
        <div class="what">
          <span class="kind">{KIND_LABEL[e.kind] ?? e.kind}</span>
          {e.title}
          {e.multi && <span class="detail multi-tag">多人线</span>}
        </div>
      </li>
    ))}
  </ol>
) : (
  <p class="meta">暂无时间线条目。可在本人物夹加入 <code>timeline.yml</code>。</p>
)}
