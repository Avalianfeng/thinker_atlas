---
import Base from '@layouts/Base.astro';
import { getAtlas } from '@lib/atlas';

const atlas = await getAtlas();
const notes = [...atlas.sbnotes].sort((a, b) => a.data.page.localeCompare(b.data.page));
---
<Base title="笔记">
  <div class="page">
    <h1>笔记中心里的相关笔记</h1>
    <p class="lede">
      这里只放 <code>npm run sync</code> 从 SilverBullet 拉下来的只读副本（带 <code>atlas:</code> 标记的笔记）。原稿永远在笔记中心改，改完再同步一次。
    </p>
    <ul class="listing">
      {notes.map((n) => (
        <li>
          <a href={`/notes/${n.data.page.replace(/\.md$/, '').replace(/^notes\//, '')}/`}>{n.data.title}</a>
          <span class="meta"><code>{n.data.page}</code></span>
          <span class="meta">{n.data.atlas.map((r) => (atlas.entities.has(r) ? atlas.ref(r).title : r)).join('、')}</span>
        </li>
      ))}
      {notes.length === 0 && (
        <li class="meta">还没有同步过笔记。在 SilverBullet 的笔记 frontmatter 里写 <code>atlas: wittgenstein</code>，然后运行 <code>npm run sync</code>。</li>
      )}
    </ul>
  </div>
</Base>

<style>
  .lede {
    font-size: 20px;
    max-width: 680px;
  }
</style>
