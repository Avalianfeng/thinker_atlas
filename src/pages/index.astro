---
import Base from '../layouts/Base.astro';
import { listPeople, initialOf } from '../lib/atlas';
import path from 'node:path';

const root = path.join(process.cwd(), 'atlas');
const people = await listPeople(root);
---
<Base title="思想者图谱">
  <ul class="wall">
    {people.map((p) => (
      <li>
        <a class="card" href={`/people/${encodeURIComponent(p.folder)}/`}>
          {p.photoUrl ? (
            <img class="photo" src={p.photoUrl} alt="" width="480" height="600" />
          ) : (
            <span class="photo initial" aria-hidden="true">{initialOf(p.name)}</span>
          )}
          <span class="name">{p.name}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
