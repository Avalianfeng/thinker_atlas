---
import { scale, tickYears } from '../lib/timeline';

interface Props {
  born: number;
  died?: number;
  events: { date: string; kind: string; title: string }[];
  accent: string;
}
const { born, died, events, accent } = Astro.props;
const W = 640;
const H = 92;
const x0 = 6;
const x1 = W - 6;
const from = born - 2;
const to = (died ?? new Date().getFullYear()) + 2;
const x = scale(from, to, x0, x1);
const years = tickYears(from, to, 10);
const pts = events
  .map((e) => ({ ...e, year: Number(e.date.slice(0, 4)) }))
  .filter((e) => e.year >= from && e.year <= to);
---
<svg class="timeline-h" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${born}—${died ?? ''} 生平缩略时间线`} style={`--accent:${accent}`}>
  <line class="axis" x1={x0} y1="52" x2={x1} y2="52" />
  <line class="life" x1={x(born)} y1="52" x2={x(died ?? to - 2)} y2="52" />
  {years.map((y) => (
    <g>
      <line class="axis" x1={x(y)} y1="48" x2={x(y)} y2="56" />
      <text x={x(y)} y="74" text-anchor="middle">{y}</text>
    </g>
  ))}
  {pts.map((e) => (
    <g>
      <title>{`${e.date} ${e.kind}：${e.title}`}</title>
      <circle class={`ev k-${e.kind}`} cx={x(e.year)} cy="52" r={e.kind === '出版' ? 3.6 : 2.6} />
    </g>
  ))}
</svg>
