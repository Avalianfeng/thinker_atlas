---
import Base from '@layouts/Base.astro';
import Placard from '@components/Placard.astro';
import Portrait from '@components/Portrait.astro';
import MultiTimeline from '@components/MultiTimeline.astro';
import { getAtlas, personUrl } from '@lib/atlas';
import { loadMultiLanes } from '@lib/timeline-yml';
import { accentMapForPeople, type AccentPerson } from '@lib/accents';
import { resolvePortrait, personSlug } from '@lib/portrait';

const atlas = await getAtlas();
/** 展厅墙默认按出生年排；无出生年靠后，同岁按 name 稳定排 */
const byBorn = [...atlas.people].sort((a, b) => {
  const ba = String(a.data.born ?? '');
  const bb = String(b.data.born ?? '');
  if (!ba && !bb) return String(a.data.name).localeCompare(String(b.data.name), 'zh');
  if (!ba) return 1;
  if (!bb) return -1;
  const cmp = ba.localeCompare(bb);
  return cmp !== 0 ? cmp : String(a.data.name).localeCompare(String(b.data.name), 'zh');
});
const accentPeople: AccentPerson[] = atlas.people.map((p) => ({
  id: p.id,
  name: p.data.name,
  born: p.data.born ? String(p.data.born) : undefined,
}));
const accentById = accentMapForPeople(accentPeople);
const multiLanes = loadMultiLanes(
  atlas.people.map((p) => ({
    id: p.id,
    name: p.data.name,
    order: p.data.order,
    accent: accentById.get(p.id)!,
    born: p.data.born ? String(p.data.born) : undefined,
    died: p.data.died ? String(p.data.died) : undefined,
  })),
);

/** 首页肖像墙：按出生年，带解析后的 src */
const wallTiles = byBorn.map((p) => {
  const slug = personSlug(p.id);
  const t = p.data;
  return {
    id: p.id,
    name: t.name as string,
    nameEn: (t.name_en as string) || '',
    url: personUrl(p.id),
    src: resolvePortrait(slug, t.portrait as string | undefined),
    accent: accentById.get(p.id)!,
  };
});
---
<Base title="展厅墙" description="私人思想展馆">
  <script is:inline>
    (() => {
      const v = localStorage.getItem('atlas:wall-view');
      document.documentElement.dataset.wallView = v === 'cards' ? 'cards' : 'detail';
    })();
  </script>
  <div class="page">
    <section class="wall-hero" aria-label="肖像墙">
      <div class="portrait-wall" data-hero-wall>
        <ul class="portrait-wall-grid">
          {wallTiles.map((tile, i) => (
            <li>
              <a
                class:list={['portrait-wall-tile', { 'is-active': i === 0 }]}
                href={tile.url}
                style={`--accent:${tile.accent}`}
                data-tile={i}
                aria-label={tile.name}
              >
                <Portrait
                  class="portrait"
                  name={tile.name}
                  original={tile.nameEn || tile.name}
                  accent={tile.accent}
                  src={tile.src}
                  showYears={false}
                />
                <span class="portrait-wall-cap">
                  <span class="zh">{tile.name}</span>
                  {tile.nameEn && <span class="latin orig">{tile.nameEn}</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <div class="view-switch">
      <button type="button" class="view-btn" id="tg-wall-view" aria-label="切换到卡片">卡片</button>
    </div>

    <section class="wall" aria-label="人物展牌">
      {byBorn.map((p, i) => (
        <Placard
          person={p}
          index={i}
          allPeople={accentPeople}
          accent={accentById.get(p.id)}
        />
      ))}
    </section>

    <script is:inline>
      (() => {
        if (document.documentElement.dataset.wallView === 'cards') {
          document.querySelector('.wall')?.classList.add('wall--cards');
        }
      })();
    </script>

    {multiLanes.length > 0 && (
      <section class="home-multi" aria-label="多人时间线">
        <h2 class="section-title">多人时间线</h2>
        <MultiTimeline lanes={multiLanes} />
      </section>
    )}
  </div>
</Base>

<style>
  .wall-hero {
    padding: calc(var(--u) * 2) 0 calc(var(--u) * 4);
    border-bottom: 1px solid var(--rule);
    margin-bottom: calc(var(--u) * 4);
  }
  .portrait-wall-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: calc(var(--u) * 2);
  }
  .portrait-wall-tile {
    --accent: var(--ink-2);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border-top: 3px solid transparent;
    opacity: 0.62;
    transition:
      opacity 1.2s ease,
      border-color 1.2s ease,
      background var(--dur) ease;
  }
  .portrait-wall-tile.is-active {
    opacity: 1;
    border-top-color: var(--accent);
  }
  .portrait-wall-tile:hover,
  .portrait-wall-tile:focus-visible {
    opacity: 1;
    background: var(--paper-2);
  }
  .portrait-wall-tile:focus-visible {
    outline: 2px solid var(--ink-2);
    outline-offset: 2px;
  }
  .portrait-wall-tile :global(.portrait),
  .portrait-wall-tile :global(.portrait-img),
  .portrait-wall-tile :global(.portrait-svg) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }
  .portrait-wall-cap {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: calc(var(--u) * 1.25) calc(var(--u) * 0.5) calc(var(--u) * 0.5);
  }
  .portrait-wall-cap .zh {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: var(--fs-h4);
    line-height: 1.35;
  }
  .portrait-wall-cap .orig {
    font-family: var(--font-latin);
    font-size: var(--fs-small);
    color: var(--ink-2);
    line-height: 1.35;
  }
  @media (min-width: 640px) {
    .portrait-wall-grid {
      grid-template-columns: repeat(auto-fit, minmax(200px, 280px));
      justify-content: start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .portrait-wall-tile {
      opacity: 1;
      transition: none;
    }
  }
  .home-multi {
    margin-top: calc(var(--u) * 8);
    padding-top: calc(var(--u) * 4);
    border-top: 1px solid var(--rule);
  }
</style>
