---
interface Props {
  level: '种子' | '生长中' | '成形';
}
const { level } = Astro.props;
const n = { 种子: 1, 生长中: 2, 成形: 3 }[level];
---
<span class="maturity" title={`成熟度：${level}`}>
  <span class="dots" aria-hidden="true">{[1, 2, 3].map((i) => <span class:list={['dot', { on: i <= n }]} />)}</span>
  {level}
</span>
