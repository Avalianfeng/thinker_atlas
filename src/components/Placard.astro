---
import Portrait from './Portrait.astro';
import Maturity from './Maturity.astro';
import { lifespan, thinkerUrl } from '../lib/atlas';
import { resolvePortrait, thinkerSlug } from '../lib/portrait';
interface Props {
  thinker: any;
  index: number;
  mini?: boolean;
}
const { thinker, index, mini = false } = Astro.props;
const t = thinker.data;
const years = lifespan(thinker);
const portraitSrc = resolvePortrait(thinkerSlug(thinker.id), t.portrait);
---
<a class:list={['placard', { mini }]} href={thinkerUrl(thinker.id)} style={`--accent:${t.accent};--o-join:${index};--o-year:${t.born.date}`}>
  <Portrait class="portrait" name={t.name.zh} original={t.name.original || t.name.en} years={years} accent={t.accent} src={portraitSrc} />
  <div class="body">
    <div class="zh">{t.name.zh}</div>
    {!mini && <div class="orig">{t.name.original || t.name.en}</div>}
    <div class="years num">{years}{t.fields.length ? ` · ${t.fields.join('、')}` : ''}</div>
    {!mini && <p class="intro">{t.intro}</p>}
    <Maturity level={t.maturity} />
  </div>
</a>
