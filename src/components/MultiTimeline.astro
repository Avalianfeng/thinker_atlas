---
/**
 * 主页底部多人横向时间线。
 * - 每行一人；横轴时间；圆点旁常显短标题（同行避让）
 * - 行线 = born→died（无 born 回退事件跨度；在世用至今年）；行色=人物冷色 accent
 * - kind 用形状区分（非配色）：●○■◆△
 * - 悬停或点击开 tip（可含时年、kind）；点空白 / Esc 关；标记不跳转
 * - 可横向拖/滑
 */
import { scale, tickYears } from '@lib/timeline';
import { yearOf } from '@lib/ids';
import {
  ageAtEvent,
  formatEventWhen,
  KIND_LABEL,
  laneLifeSpan,
  layoutLaneLabels,
  multiYearSpan,
  shortTitle,
  type TimelineKind,
  type TimelineLane,
} from '@lib/timeline-yml';

interface Props {
  lanes: TimelineLane[];
}
const { lanes } = Astro.props;
const span = multiYearSpan(lanes, 3);
const empty = !span || lanes.length === 0;

const PX_PER_YEAR = 14;
const padL = 8;
const padR = 28;
const laneH = 72;
const top = 36;
const bottom = 28;
const W = empty ? 400 : Math.max(640, Math.round((span!.to - span!.from) * PX_PER_YEAR) + padL + padR);
const H = top + laneH * Math.max(lanes.length, 1) + bottom;
const x = empty ? ((_y: number) => 0) : scale(span!.from, span!.to, padL, W - padR);
const ticks = empty ? [] : tickYears(span!.from, span!.to, 10);

type Pt = {
  cx: number;
  cy: number;
  when: string;
  title: string;
  short: string;
  person: string;
  kind: TimelineKind;
  kindLabel: string;
  age?: number;
  showLabel: boolean;
  labelDy: number;
  leader: boolean;
};

const points: Pt[] = [];
if (!empty) {
  lanes.forEach((lane, i) => {
    const cy = top + i * laneH + laneH / 2 - 6;
    const raw: { cx: number; short: string; e: (typeof lane.events)[number] }[] = [];
    for (const e of lane.events) {
      const y = yearOf(e.date);
      if (y === undefined) continue;
      raw.push({
        cx: Math.round(x(y) * 100) / 100,
        short: shortTitle(e.title, 6),
        e,
      });
    }
    const places = layoutLaneLabels(raw.map((r) => ({ cx: r.cx, short: r.short })));
    raw.forEach((r, j) => {
      const place = places[j]!;
      const age = ageAtEvent(lane.born, r.e.date);
      points.push({
        cx: r.cx,
        cy,
        when: formatEventWhen(r.e),
        title: r.e.title,
        short: r.short,
        person: lane.name,
        kind: r.e.kind,
        kindLabel: KIND_LABEL[r.e.kind] ?? r.e.kind,
        age,
        showLabel: place.show,
        labelDy: place.dy,
        leader: place.leader,
      });
    });
  });
}

const R = 4.5;
function diamondPts(cx: number, cy: number, r = R) {
  return `${cx},${cy - r} ${cx + r},${cy} ${cx},${cy + r} ${cx - r},${cy}`;
}
function trianglePts(cx: number, cy: number, r = R) {
  // 向上空心三角外接
  return `${cx},${cy - r} ${cx + r},${cy + r * 0.75} ${cx - r},${cy + r * 0.75}`;
}

const legend: { kind: TimelineKind; label: string; shape: string }[] = [
  { kind: 'life', label: KIND_LABEL.life, shape: 'filled-circle' },
  { kind: 'write', label: KIND_LABEL.write, shape: 'hollow-circle' },
  { kind: 'publish', label: KIND_LABEL.publish, shape: 'filled-square' },
  { kind: 'meet', label: KIND_LABEL.meet, shape: 'filled-diamond' },
  { kind: 'context', label: KIND_LABEL.context, shape: 'hollow-triangle' },
];
---
{empty ? (
  <p class="meta mtl-empty">暂无多人事件（需在 timeline.yml 中设 multi: true）。</p>
) : (
  <div class="mtl-block" data-mtl>
    <div class="mtl-frame">
      <ul class="mtl-names" aria-hidden="true">
        {lanes.map((lane) => (
          <li style={`--accent:${lane.accent}`}>
            <span class="dot" />
            <span class="name">{lane.name}</span>
          </li>
        ))}
      </ul>
      <div class="mtl-scroll" data-mtl-scroll tabindex="0" role="region" aria-label="多人时间线，可横向拖动或滚动">
        <svg class="mtl" viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-label="多人并置时间线">
          <line class="axis" x1={padL} y1={H - bottom + 4} x2={W - padR} y2={H - bottom + 4} />
          {ticks.map((y) => (
            <g>
              <line class="tick" x1={x(y)} y1={H - bottom} x2={x(y)} y2={H - bottom + 8} />
              <text class="tick-label" x={x(y)} y={H - 4} text-anchor="middle">{y}</text>
            </g>
          ))}
          {lanes.map((lane, i) => {
            const cy = top + i * laneH + laneH / 2 - 6;
            const life = laneLifeSpan(lane);
            const x0 = life ? x(life.from) : padL;
            const x1 = life ? x(life.to) : padL;
            return (
              <g data-lane={lane.personId}>
                <line class="lane-line" x1={x0} y1={cy} x2={x1} y2={cy} style={`stroke:${lane.accent}`} />
              </g>
            );
          })}
          {points.map((p) => (
            <g class="ev-g" data-kind={p.kind}>
              {p.showLabel && p.leader && (
                <line
                  class="ev-leader"
                  x1={p.cx}
                  y1={p.cy}
                  x2={p.cx}
                  y2={p.cy + p.labelDy - (p.labelDy > 0 ? 4 : -2)}
                />
              )}
              {p.kind === 'life' && <circle class="ev-mark filled" cx={p.cx} cy={p.cy} r={R} />}
              {p.kind === 'write' && <circle class="ev-mark hollow" cx={p.cx} cy={p.cy} r={R} />}
              {p.kind === 'publish' && (
                <rect class="ev-mark filled" x={p.cx - R} y={p.cy - R} width={R * 2} height={R * 2} />
              )}
              {p.kind === 'meet' && <polygon class="ev-mark filled" points={diamondPts(p.cx, p.cy)} />}
              {p.kind === 'context' && <polygon class="ev-mark hollow" points={trianglePts(p.cx, p.cy)} />}
              {/* 透明命中区：脚本只绑 .ev，标记本身不接指针 */}
              <circle
                class="ev"
                cx={p.cx}
                cy={p.cy}
                r="9"
                data-when={p.when}
                data-title={p.title}
                data-person={p.person}
                data-kind-label={p.kindLabel}
                data-age={p.age !== undefined ? String(p.age) : undefined}
                tabindex="0"
                role="button"
                aria-label={`${p.person} ${p.when} ${p.title}${p.age !== undefined ? ` 时年 ${p.age}` : ''} ${p.kindLabel}`}
              />
              {p.showLabel && (
                <text class="ev-label" x={p.cx} y={p.cy + p.labelDy} text-anchor="middle">
                  {p.short}
                </text>
              )}
            </g>
          ))}
        </svg>
      </div>
    </div>
    <ul class="mtl-legend" aria-label="事件类型图例">
      {legend.map((item) => (
        <li data-shape={item.shape}>
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            {item.shape === 'filled-circle' && <circle class="ev-mark filled" cx="7" cy="7" r="4.5" />}
            {item.shape === 'hollow-circle' && <circle class="ev-mark hollow" cx="7" cy="7" r="4.5" />}
            {item.shape === 'filled-square' && <rect class="ev-mark filled" x="2.5" y="2.5" width="9" height="9" />}
            {item.shape === 'filled-diamond' && <polygon class="ev-mark filled" points="7,2 12,7 7,12 2,7" />}
            {item.shape === 'hollow-triangle' && <polygon class="ev-mark hollow" points="7,2 12,11.5 2,11.5" />}
          </svg>
          <span>{item.label}</span>
        </li>
      ))}
    </ul>
    <div class="mtl-tip" data-mtl-tip hidden></div>
  </div>
)}

<script>
  function bind(root: HTMLElement) {
    const scroll = root.querySelector<HTMLElement>('[data-mtl-scroll]');
    const tip = root.querySelector<HTMLElement>('[data-mtl-tip]');
    if (!scroll || !tip) return;

    let dragging = false;
    let startX = 0;
    let startLeft = 0;
    let pinned: SVGCircleElement | null = null;

    const onDown = (e: PointerEvent) => {
      if ((e.target as Element).closest('circle.ev')) return;
      dragging = true;
      startX = e.clientX;
      startLeft = scroll.scrollLeft;
      scroll.setPointerCapture(e.pointerId);
      scroll.classList.add('dragging');
    };
    const onMove = (e: PointerEvent) => {
      if (!dragging) return;
      scroll.scrollLeft = startLeft - (e.clientX - startX);
    };
    const onUp = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      scroll.classList.remove('dragging');
      try {
        scroll.releasePointerCapture(e.pointerId);
      } catch {
        /* ignore */
      }
    };
    scroll.addEventListener('pointerdown', onDown);
    scroll.addEventListener('pointermove', onMove);
    scroll.addEventListener('pointerup', onUp);
    scroll.addEventListener('pointercancel', onUp);

    const placeTip = (clientX: number, clientY: number) => {
      const rect = root.getBoundingClientRect();
      tip.style.left = `${Math.min(rect.width - 12, Math.max(12, clientX - rect.left))}px`;
      tip.style.top = `${Math.max(8, clientY - rect.top - 12)}px`;
    };

    const show = (el: SVGCircleElement, clientX?: number, clientY?: number) => {
      const when = el.dataset.when ?? '';
      const title = el.dataset.title ?? '';
      const person = el.dataset.person ?? '';
      const kindLabel = el.dataset.kindLabel ?? '';
      const age = el.dataset.age;
      const parts = [person, when, title];
      if (kindLabel) parts.push(kindLabel);
      if (age !== undefined && age !== '') parts.push(`时年 ${age}`);
      tip.hidden = false;
      tip.textContent = parts.join(' · ');
      if (clientX != null && clientY != null) {
        placeTip(clientX, clientY);
      } else {
        const r = el.getBoundingClientRect();
        placeTip(r.left + r.width / 2, r.top);
      }
    };

    const hideIfUnpinned = () => {
      if (pinned) {
        show(pinned);
        return;
      }
      tip.hidden = true;
    };

    const close = () => {
      pinned = null;
      tip.hidden = true;
    };

    root.querySelectorAll<SVGCircleElement>('circle.ev').forEach((el) => {
      el.addEventListener('pointerenter', (e) => show(el, e.clientX, e.clientY));
      el.addEventListener('pointermove', (e) => {
        if (!pinned || pinned === el) show(el, e.clientX, e.clientY);
      });
      el.addEventListener('pointerleave', hideIfUnpinned);
      el.addEventListener('focus', () => show(el));
      el.addEventListener('blur', () => {
        if (pinned === el) return;
        hideIfUnpinned();
      });
      // Aeris：点击标记不进入人物页；悬停或点击都开 tip
      el.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        pinned = el;
        show(el, e.clientX, e.clientY);
      });
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          pinned = el;
          show(el);
        }
      });
    });

    root.addEventListener('click', (e) => {
      if ((e.target as Element).closest('circle.ev')) return;
      close();
    });

    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') close();
    };
    document.addEventListener('keydown', onKey);
  }

  document.querySelectorAll<HTMLElement>('[data-mtl]').forEach(bind);
</script>
