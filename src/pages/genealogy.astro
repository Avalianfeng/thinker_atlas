---
import Base from '../layouts/Base.astro';
import GraphMap from '../components/GraphMap.astro';
import Relation from '../components/Relation.astro';
import { getAtlas } from '@lib/atlas';

const atlas = await getAtlas();
const types = ['影响', '批判', '师承', '对话', '平行', '误读'];
const counts = Object.fromEntries(types.map((t) => [t, atlas.relations.filter((r) => r.data.type === t).length]));
const legendStyle = (t: string) => {
  const dash = { 批判: '7 4', 对话: '2 4', 平行: '10 3 2 3', 误读: '1 3 8 3' }[t];
  const width = t === '师承' ? 3 : 1.4;
  return `stroke-dasharray:${dash ?? 'none'};stroke-width:${width}`;
};
---
<Base title="谱系">
  <div class="page">
    <h1>谱系</h1>
    <p class="lede">
      跨领域的关系在这里串起来。横轴是年代，纵轴是人物；线型区分关系类型，箭头指向被影响的一方，「平行」「对话」为双向。图是构建时生成的静态 SVG，不加载任何图形库。
    </p>

    <div class="graph-legend">
      {types.map((t) => (
        <span>
          <svg width="34" height="8" aria-hidden="true"><line x1="0" y1="4" x2="34" y2="4" class={`t-${t}`} style={legendStyle(t)} /></svg>
          {t}{counts[t] > 0 && <span class="num">（{counts[t]}）</span>}
        </span>
      ))}
      <span>节点颜色 = 人物强调色；虚线 = 待核实</span>
    </div>

    <div class="graph-wrap">
      <GraphMap thinkers={atlas.thinkers} relations={atlas.relations} atlas={atlas} />
    </div>

    <h2 class="section-title">全部关系条目（{atlas.relations.length}）</h2>
    <div class="filter-bar">
      <span>按人物筛选</span>
      <a href="/genealogy/" aria-current="page">全部</a>
      {atlas.thinkers.map((t) => (
        <a href={`/thinkers/${t.id.replace('atlas:', '')}/genealogy/`}>{t.data.name.zh}</a>
      ))}
    </div>
    {atlas.relations.map((r) => <Relation relation={r} atlas={atlas} />)}
    {atlas.relations.length === 0 && <p class="meta">还没有关系条目。</p>}
  </div>
</Base>

<style>
  .lede {
    font-size: 20px;
    max-width: 700px;
  }
  .graph-wrap {
    border: 1px solid var(--rule);
    padding: calc(var(--u) * 2);
    overflow-x: auto;
    margin-bottom: calc(var(--u) * 3);
  }
</style>
