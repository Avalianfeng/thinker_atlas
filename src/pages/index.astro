---
import Base from '@layouts/Base.astro';
import Placard from '@components/Placard.astro';
import MultiTimeline from '@components/MultiTimeline.astro';
import { getAtlas, entityForFile, personUrl } from '@lib/atlas';
import { recentCommits, formatDay } from '@lib/git';
import { loadMultiLanes } from '@lib/timeline-yml';

const atlas = await getAtlas();
const joinOrder = atlas.people;
const byYear = [...atlas.people].sort((a, b) => String(a.data.born ?? '').localeCompare(String(b.data.born ?? '')));
const accents = ['#6E7F94', '#8B7355', '#5F7A6A', '#7A6A82', '#8A6E5C'];
const accentOf = (name: string) => {
  const seed = [...String(name)].reduce((a, c) => a + (c.codePointAt(0) ?? 0), 0);
  return accents[seed % accents.length]!;
};
const multiLanes = loadMultiLanes(
  atlas.people.map((p) => ({
    id: p.id,
    name: p.data.name,
    order: p.data.order,
    accent: accentOf(p.data.name),
  })),
);

const recent = recentCommits(40)
  .flatMap((c) => c.files.map((f) => ({ file: f, date: c.date, subject: c.subject })))
  .map((r) => ({ ...r, entity: entityForFile(atlas, r.file) }))
  .filter((r) => r.entity)
  .filter((r, i, arr) => arr.findIndex((x) => x.entity!.id === r.entity!.id) === i)
  .slice(0, 6);
---
<Base title="展厅墙" description="私人思想展馆：一人一夹，标准 Markdown">
  <div class="page">
    <section class="wall-hero">
      <h1>思想的展厅</h1>
      <p class="lede">
        每个人物是一间展厅。内容在 git 的 <code>content/people/</code>，标准 Markdown，独立构建。
      </p>
      <p class="meta">目前 {atlas.people.length} 位人物 · {atlas.pieces.length} 篇正文</p>
    </section>

    <div class="sorter">
      <span>排序</span>
      <input type="radio" name="sort" id="sort-join" checked />
      <label for="sort-join">按加入顺序</label>
      <input type="radio" name="sort" id="sort-year" />
      <label for="sort-year">按年代</label>
    </div>

    <section class="wall" aria-label="人物展牌">
      {joinOrder.map((p, i) => (
        <div style={`--o-join:${i};--o-year:${byYear.findIndex((x) => x.id === p.id)}`} class="wall-cell">
          <Placard person={p} index={i} />
        </div>
      ))}
    </section>

    <div class="home-cols">
      <section>
        <h2 class="section-title">最近修改</h2>
        <ul class="listing">
          {recent.map((r) => (
            <li>
              <a href={r.entity!.url}>{r.entity!.title}</a>
              <span class="meta num">{formatDay(r.date)}</span>
            </li>
          ))}
          {recent.length === 0 && <li class="meta">暂无提交记录。</li>}
        </ul>
      </section>
      <section>
        <h2 class="section-title">从这里开始</h2>
        <ul class="listing">
          <li><a href={personUrl('wittgenstein')}>维特根斯坦</a><span class="meta">样例展厅</span></li>
          <li><a href={personUrl('russell')}>罗素</a><span class="meta">多人线样例</span></li>
        </ul>
      </section>
    </div>

    {multiLanes.length > 0 && (
      <section class="home-multi" aria-label="多人时间线">
        <h2 class="section-title">多人时间线</h2>
        <p class="meta mtl-lede">各人一条线；只显示标了 multi 的事件。悬停看日期与标题；可横向拖动。圆点不跳转。</p>
        <MultiTimeline lanes={multiLanes} />
      </section>
    )}
  </div>
</Base>

<style>
  .wall-hero {
    padding: calc(var(--u) * 4) 0 calc(var(--u) * 5);
    border-bottom: 1px solid var(--rule);
    margin-bottom: calc(var(--u) * 4);
  }
  .wall-hero h1 {
    font-size: 40px;
    letter-spacing: 0.06em;
  }
  .lede {
    font-size: 20px;
    max-width: 640px;
    line-height: 1.8;
  }
  .wall-cell {
    flex: 0 0 calc((100% - var(--u) * 9) / 4);
    min-width: 220px;
    display: flex;
  }
  .wall-cell :global(.placard) {
    flex: 1;
  }
  @media (max-width: 1199px) {
    .wall-cell {
      flex-basis: calc((100% - var(--u) * 3) / 2);
    }
  }
  @media (max-width: 560px) {
    .wall-cell {
      flex-basis: 100%;
    }
  }
  .home-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gutter);
    margin-top: calc(var(--u) * 6);
  }
  @media (max-width: 767px) {
    .home-cols {
      grid-template-columns: 1fr;
    }
  }
  .home-multi {
    margin-top: calc(var(--u) * 8);
    padding-top: calc(var(--u) * 4);
    border-top: 1px solid var(--rule);
  }
  .mtl-lede {
    margin: 0 0 calc(var(--u) * 2);
    max-width: 40rem;
  }
</style>
