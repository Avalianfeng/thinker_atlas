---
import Base from '@layouts/Base.astro';
import GraphMap from '@components/GraphMap.astro';
import Relation from '@components/Relation.astro';
import { getAtlas } from '@lib/atlas';

const atlas = await getAtlas();
const filter = Astro.url.searchParams.get('thinker');
const relations = filter && filter !== 'all'
  ? atlas.relations.filter((r) => [r.data.from, r.data.to].some((x) => `atlas:${x.split('/')[0].replace('atlas:', '')}` === `atlas:${filter}` || x === filter))
  : atlas.relations;
const types = ['影响', '批判', '师承', '对话', '平行', '误读'];
const counts = Object.fromEntries(types.map((t) => [t, atlas.relations.filter((r) => r.data.type === t).length]));
---
<Base title="谱系">
  <div class="page">
    <h1>谱系</h1>
    <p class="lede">
      跨领域的关系在这里串起来。横轴是年代，纵轴是人物；线型区分关系类型，虚线为批判，粗线为师承，箭尾为施加影响的一方。图由构建时生成的静态 SVG 绘制，不加载任何图形库。
    </p>

    <div class="graph-legend">
      {types.map((t) => (
        <span>
          <svg width="34" height="8" aria-hidden="true"><line x1="0" y1="4" x2="34" y2="4" class={`t-${t}`} stroke-dasharray={t === '批判' ? '7 4' : t === '对话' ? '2 4' : t === '平行' ? '10 3 2 3' : t === '误读' ? '1 3 8 3' : undefined} stroke-width={t === '师承' ? 3 : 1.4} /></svg>
          {t} {counts[t] > 0 && <span class="num">({counts[t]})</span>}
        </span>
      ))}
      <span>箭头 = 方向；节点颜色 = 人物强调色</span>
    </div>

    <div class="graph-wrap">
      <GraphMap thinkers={atlas.thinkers} relations={atlas.relations} atlas={atlas} highlight={filter && filter !== 'all' ? `atlas:${filter}` : undefined} />
    </div>

    <h2 class="section-title">全部关系条目（{atlas.relations.length}）</h2>
    <div class="filter-bar">
      <span>筛选</span>
      <a href="/genealogy/" aria-current={!filter ? 'page' : undefined}>全部</a>
      {atlas.thinkers.map((t) => (
        <a href={`/genealogy/?thinker=${t.id.replace('atlas:', '')}`} aria-current={filter === t.id.replace('atlas:', '') ? 'page' : undefined}>{t.data.name.zh}</a>
      ))}
    </div>
    {relations.map((r) => <Relation relation={r} atlas={atlas} />)}
    {relations.length === 0 && <p class="meta">这位人物还没有关系条目。</p>}
  </div>
</Base>

<style>
  .lede {
    font-size: 20px;
    max-width: 700px;
  }
  .graph-wrap {
    border: 1px solid var(--rule);
    padding: calc(var(--u) * 2);
    overflow-x: auto;
    margin-bottom: calc(var(--u) * 3);
  }
</style>
