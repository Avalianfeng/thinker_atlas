# 复制为 .env 后填写；.env 不进 git。
# ---- 站点 ----
ATLAS_SITE_URL=https://atlas.example.com

# ---- 部署（npm run deploy）----
DEPLOY_HOST=vps.example.com
DEPLOY_USER=atlas
DEPLOY_PATH=/var/www/atlas
DEPLOY_PORT=22
# DEPLOY_SSH_KEY=~/.ssh/atlas_deploy
# DEPLOY_DRY_RUN=1

# ---- 遗留：SilverBullet 同步（默认禁用）----
# Atlas 独立运行，展馆真源 = git content/。不要把 SB 当展馆真源。
# npm run sync 默认 no-op；仅当你显式传 --enable 时才读取下列变量。
# ATLAS_SYNC_ENABLED=1
# ATLAS_NOTES_ADAPTER=silverbullet
# SB_URL=https://note.example.com
# SB_USER=me:password
# ATLAS_NOTES_ADAPTER=local-folder
# ATLAS_NOTES_LOCAL_DIR=./tmp/sb
