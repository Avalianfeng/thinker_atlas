---
import Base from '@layouts/Base.astro';
import Placard from '@components/Placard.astro';
import MultiTimeline from '@components/MultiTimeline.astro';
import { getAtlas } from '@lib/atlas';
import { loadMultiLanes } from '@lib/timeline-yml';
import { accentMapForPeople, type AccentPerson } from '@lib/accents';

const atlas = await getAtlas();
/** 展厅墙默认按出生年排；无出生年靠后，同岁按 name 稳定排 */
const byBorn = [...atlas.people].sort((a, b) => {
  const ba = String(a.data.born ?? '');
  const bb = String(b.data.born ?? '');
  if (!ba && !bb) return String(a.data.name).localeCompare(String(b.data.name), 'zh');
  if (!ba) return 1;
  if (!bb) return -1;
  const cmp = ba.localeCompare(bb);
  return cmp !== 0 ? cmp : String(a.data.name).localeCompare(String(b.data.name), 'zh');
});
const accentPeople: AccentPerson[] = atlas.people.map((p) => ({
  id: p.id,
  name: p.data.name,
  born: p.data.born ? String(p.data.born) : undefined,
}));
const accentById = accentMapForPeople(accentPeople);
const multiLanes = loadMultiLanes(
  atlas.people.map((p) => ({
    id: p.id,
    name: p.data.name,
    order: p.data.order,
    accent: accentById.get(p.id)!,
    born: p.data.born ? String(p.data.born) : undefined,
    died: p.data.died ? String(p.data.died) : undefined,
  })),
);
---
<Base title="展厅墙" description="私人思想展馆">
  <script is:inline>
    (() => {
      const v = localStorage.getItem('atlas:wall-view');
      document.documentElement.dataset.wallView = v === 'cards' ? 'cards' : 'detail';
    })();
  </script>
  <div class="page">
    <section class="wall-hero">
      <h1>思想的展厅</h1>
    </section>

    <div class="view-switch" role="group" aria-label="视图">
      <span class="view-switch-label">视图</span>
      <button type="button" class="view-btn" data-wall-view="detail" aria-pressed="true">详牌</button>
      <button type="button" class="view-btn" data-wall-view="cards" aria-pressed="false">卡片</button>
    </div>

    <section class="wall" aria-label="人物展牌">
      {byBorn.map((p, i) => (
        <Placard
          person={p}
          index={i}
          allPeople={accentPeople}
          accent={accentById.get(p.id)}
        />
      ))}
    </section>

    <script is:inline>
      (() => {
        if (document.documentElement.dataset.wallView === 'cards') {
          document.querySelector('.wall')?.classList.add('wall--cards');
        }
      })();
    </script>

    {multiLanes.length > 0 && (
      <section class="home-multi" aria-label="多人时间线">
        <h2 class="section-title">多人时间线</h2>
        <MultiTimeline lanes={multiLanes} />
      </section>
    )}
  </div>
</Base>

<style>
  .wall-hero {
    padding: calc(var(--u) * 4) 0 calc(var(--u) * 5);
    border-bottom: 1px solid var(--rule);
    margin-bottom: calc(var(--u) * 4);
  }
  .wall-hero h1 {
    font-size: 40px;
    letter-spacing: 0.06em;
  }
  .home-multi {
    margin-top: calc(var(--u) * 8);
    padding-top: calc(var(--u) * 4);
    border-top: 1px solid var(--rule);
  }
</style>
