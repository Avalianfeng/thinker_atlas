---
import Base from '@layouts/Base.astro';
import { getAtlas } from '@lib/atlas';

const atlas = await getAtlas();
const notes = [...atlas.sbnotes].sort((a, b) => a.data.page.localeCompare(b.data.page));
---
<Base title="笔记">
  <div class="page">
    <h1>本地笔记缓存（遗留）</h1>
    <p class="lede">
      <code>content/sb-cache/</code> 是遗留缓存目录。Atlas 独立运行后不再默认从外部笔记应用拉取；新内容请直接写进 <code>content/thinkers/</code>。
    </p>
    <ul class="listing">
      {notes.map((n) => (
        <li>
          <a href={`/notes/${n.data.page.replace(/\.md$/, '').replace(/^notes\//, '')}/`}>{n.data.title}</a>
          <span class="meta"><code>{n.data.page}</code></span>
          <span class="meta">{n.data.atlas.map((r) => (atlas.entities.has(r) ? atlas.ref(r).title : r)).join('、')}</span>
        </li>
      ))}
      {notes.length === 0 && (
        <li class="meta">缓存为空。日常写作请编辑 git 里的 <code>content/</code>。</li>
      )}
    </ul>
  </div>
</Base>

<style>
  .lede {
    font-size: 20px;
    max-width: 680px;
  }
</style>
