---
import Hall from '@layouts/Hall.astro';
import { getAtlas, workUrl } from '@lib/atlas';

export async function getStaticPaths() {
  const atlas = await getAtlas();
  return atlas.thinkers
    .filter((t) => atlas.worksOf(t.id).length > 0)
    .map((t) => ({ params: { thinker: t.id.replace('atlas:', '') }, props: { thinkerId: t.id } }));
}

const atlas = await getAtlas();
const thinker = atlas.thinker(Astro.props.thinkerId);
const works = atlas.worksOf(thinker.id);
---
<Hall atlas={atlas} thinker={thinker} title="作品">
  <h1>作品</h1>
  <p class="lede">按出版年排列。每部作品记结构、核心论题与我的阅读笔记；版本信息不确认的不写具体页码。</p>
  <ul class="works-list">
    {works.map((w) => (
      <li>
        <a href={workUrl(w.id)}>
          <span class="year num">{w.data.year}</span>
          <span class="t">{w.data.title}</span>
          <span class="o latin">{w.data.original}</span>
        </a>
        <span class="meta">{w.data.written ? `写于 ${w.data.written}` : ''}{w.data.structure.length ? ` · ${w.data.structure.length} 个部分` : ''}</span>
      </li>
    ))}
  </ul>
  <p><a href={`/thinkers/${Astro.props.thinkerId.replace('atlas:', '')}/`}>← 回到展厅</a></p>
</Hall>

<style>
  .lede {
    font-size: 20px;
    max-width: 640px;
  }
  .works-list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--rule);
    margin-top: calc(var(--u) * 4);
  }
  .works-list li {
    border-bottom: 1px solid var(--rule);
    padding: calc(var(--u) * 2) 0;
  }
  .works-list a {
    display: flex;
    gap: calc(var(--u) * 2);
    align-items: baseline;
    text-decoration: none;
    flex-wrap: wrap;
  }
  .works-list .year {
    font-family: var(--font-latin);
    color: var(--ink-2);
    min-width: 3.5em;
  }
  .works-list .t {
    font-family: var(--font-sans);
    font-size: var(--fs-h3);
    font-weight: 500;
  }
  .works-list .o {
    color: var(--ink-2);
  }
  .works-list .meta {
    display: block;
    margin-left: calc(var(--u) * 5.5);
  }
</style>
