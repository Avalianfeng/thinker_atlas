# 复制为 .env 后填写；.env 不进 git。
# ---- 站点 ----
ATLAS_SITE_URL=https://atlas.example.com

# ---- SilverBullet 同步（npm run sync）----
# 笔记适配器：silverbullet（默认，走 HTTP /.fs/）或 local-folder（离线目录）
ATLAS_NOTES_ADAPTER=silverbullet
SB_URL=https://note.example.com
# SB_USER 形式：用户名:密码，或已带 scheme 的 token（Basic xxx / Bearer xxx）
SB_USER=me:password
# local-folder 适配器的根目录（相对仓库根）
ATLAS_NOTES_LOCAL_DIR=./tmp/sb

# ---- 部署（npm run deploy）----
DEPLOY_HOST=vps.example.com
DEPLOY_USER=atlas
DEPLOY_PATH=/var/www/atlas
DEPLOY_PORT=22
# DEPLOY_SSH_KEY=~/.ssh/atlas_deploy
# DEPLOY_DRY_RUN=1
