---
import Mdx from '@components/Mdx.astro';
import Hall from '@layouts/Hall.astro';
import ConceptCard from '@components/ConceptCard.astro';
import ProvenanceBar from '@components/ProvenanceBar.astro';
import { getAtlas, conceptUrl, parseId } from '@lib/atlas';
import { extractNotes, provenanceStats } from '@lib/provenance';
import { render } from 'astro:content';
import { formatDay } from '@lib/git';

export async function getStaticPaths() {
  const atlas = await getAtlas();
  return atlas.concepts.map((c) => {
    const { thinker, item } = parseId(c.id);
    return { params: { thinker, concept: item }, props: { conceptId: c.id } };
  });
}

const atlas = await getAtlas();
const concept = atlas.concepts.find((c) => c.id === Astro.props.conceptId)!;
const d = concept.data;
const thinker = atlas.thinker(`atlas:${parseId(d.id).thinker}`);
const { headings } = await render(concept);
const stats = provenanceStats(concept.body);
const notes = extractNotes(concept.body);
const base = `/thinkers/${parseId(d.id).thinker}`;
const updated = atlas.updatedOf(d.id);

const siblings = atlas.conceptsOf(thinker.id).filter((c) => c.id !== d.id);
const evolutions = d.evolution ?? [];
const interlocutors = (d.interlocutors ?? []).map((i) => ({ ...i, ref: atlas.entities.get(i.concept) })).filter((i) => i.ref);
const backlinks = atlas.relationsOf(d.id);
const journal = atlas.journalFor(d.id);
const sb = atlas.notesFor(d.id);
---
<Hall atlas={atlas} thinker={thinker} title={d.title}>
  <div class="essay">
    <aside class="toc-side">
      <div class="toc">
        <div class="toc-title">本文</div>
        <ol>
          {headings.filter((h) => h.depth <= 3).map((h) => (
            <li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
          {evolutions.length > 0 && <li><a href="#evolution">演变</a></li>}
          {interlocutors.length > 0 && <li><a href="#interlocutors">对话者</a></li>}
          {notes.length > 0 && <li><a href="#my-notes">我的批注</a></li>}
        </ol>
      </div>
    </aside>
    <details class="toc-bar">
      <summary>目录</summary>
      <div class="toc">
        <ol>
          {headings.filter((h) => h.depth <= 3).map((h) => (
            <li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
          {evolutions.length > 0 && <li><a href="#evolution">演变</a></li>}
          {interlocutors.length > 0 && <li><a href="#interlocutors">对话者</a></li>}
          {notes.length > 0 && <li><a href="#my-notes">我的批注</a></li>}
        </ol>
      </div>
    </details>

    <article class="prose">
      <header class="concept-head">
        <div class="kicker">
          <a href={`${base}/thought/`}>思想</a>
          {d.original && <span class="latin" lang={d.lang}>{d.original}</span>}
          {updated && <span class="meta num" style="margin-left:auto">最后修改 {formatDay(updated)}</span>}
        </div>
        <h1>{d.title}</h1>
        <ProvenanceBar stats={stats} compact />
      </header>

      <ConceptCard concept={concept} atlas={atlas} />

      <Mdx entry={concept} />

      {evolutions.length > 0 && (
        <section id="evolution">
          <h2>演变</h2>
          <ol class="evolution">
            {evolutions.map((e) => {
              const p = thinker.data.periods.find((x: any) => x.id === e.period);
              return (
                <li>
                  <span class="period">{p?.label ?? e.period}</span>
                  <p>{e.text}</p>
                  {e.ref && <p class="meta"><a href={atlas.ref(e.ref).url}>{atlas.ref(e.ref).title} →</a></p>}
                </li>
              );
            })}
          </ol>
        </section>
      )}

      {interlocutors.length > 0 && (
        <section id="interlocutors">
          <h2>对话者</h2>
          <ul class="inter">
            {interlocutors.map((i) => (
              <li>
                <a href={i.ref!.url}>{i.ref!.title}</a>
                <span class="meta">{atlas.entities.get(`atlas:${parseId(i.ref!.id).thinker}`)?.title}</span>
                {i.note && <p>{i.note}</p>}
              </li>
            ))}
          </ul>
        </section>
      )}

      {notes.length > 0 && (
        <section id="my-notes" class="notes-summary">
          <h2>我的批注</h2>
          <p class="meta">这一页共有 {notes.length} 条批注；点顶部「批注」可全局隐藏。</p>
          <ul class="notesum">
            {notes.map((n) => (
              <li>
                <span class="note-head">{n.title || '批注'}</span>
                <p>{n.text}</p>
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>

    <aside class="side">
      {backlinks.length > 0 && (
        <>
          <h3>关系</h3>
          <ul class="side-list">
            {backlinks.map((r) => {
              const other = r.data.from === d.id ? r.data.to : r.data.from;
              return (
                <li>
                  <a href={atlas.ref(other).url}>{atlas.ref(other).title}</a>
                  <span class="meta">{r.data.type}{r.data.from === d.id ? ' →' : ' ←'}</span>
                </li>
              );
            })}
          </ul>
        </>
      )}
      {d.builds_on.length > 0 && (
        <>
          <h3>建立于</h3>
          <ul class="side-list">{d.builds_on.map((x) => <li><a href={atlas.ref(x).url}>{atlas.ref(x).title}</a></li>)}</ul>
        </>
      )}
      {d.contrasts_with.length > 0 && (
        <>
          <h3>对照</h3>
          <ul class="side-list">{d.contrasts_with.map((x) => <li><a href={atlas.ref(x).url}>{atlas.ref(x).title}</a></li>)}</ul>
        </>
      )}
      <h3>同一展厅</h3>
      <ul class="side-list">
        {siblings.map((c) => <li><a href={conceptUrl(c.id)}>{c.data.title}</a></li>)}
      </ul>
      {sb.length > 0 && (
        <>
          <h3>笔记中心里的相关笔记</h3>
          <ul class="side-list related-notes">
            {sb.map((n) => (
              <li><a href={`/notes/${n.id}/`}>{n.data.title}</a><span class="meta">{n.data.page}</span></li>
            ))}
          </ul>
        </>
      )}
      {journal.length > 0 && (
        <>
          <h3>随笔</h3>
          <ul class="side-list">
            {journal.map((j) => <li><a href={`/journal/${j.id}/`}>{j.data.title || j.id}</a><span class="meta num">{j.data.date}</span></li>)}
          </ul>
        </>
      )}
    </aside>
  </div>
</Hall>

<style>
  .concept-head {
    border-bottom: 1px solid var(--rule);
    padding-bottom: calc(var(--u) * 2);
    margin-bottom: calc(var(--u) * 3);
  }
  .concept-head h1 {
    margin: var(--u) 0;
  }
  .kicker {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    color: var(--ink-2);
    display: flex;
    gap: calc(var(--u) * 1.5);
    align-items: baseline;
  }
  .kicker a {
    text-decoration: none;
  }
  .evolution {
    list-style: none;
    padding: 0;
    border-left: 1px solid var(--rule);
  }
  .evolution li {
    padding-left: calc(var(--u) * 2.5);
    margin-bottom: var(--line);
    position: relative;
  }
  .evolution li::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 0.7em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .evolution .period {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    color: var(--ink-2);
    letter-spacing: 0.1em;
  }
  .evolution p {
    margin: var(--u) 0 0;
  }
  .inter {
    list-style: none;
    padding: 0;
  }
  .inter li {
    border-bottom: 1px solid var(--rule);
    padding: var(--u) 0 calc(var(--u) * 1.5);
  }
  .inter p {
    margin: var(--u) 0 0;
    font-size: 16px;
    color: var(--ink-2);
  }
  .notesum {
    list-style: none;
    padding: 0;
  }
  .notesum li {
    border-left: 1px solid var(--p-own);
    padding-left: calc(var(--u) * 2);
    margin-bottom: var(--line);
  }
  .notesum p {
    margin: var(--u) 0 0;
  }
  .side {
    grid-column: 3;
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: var(--lh-ui);
  }
  .side h3 {
    font-size: var(--fs-tiny);
    letter-spacing: 0.12em;
    color: var(--ink-2);
    font-weight: 500;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 4px;
    margin: calc(var(--u) * 4) 0 var(--u);
  }
  .side h3:first-child {
    margin-top: 0;
  }
  .side-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .side-list li {
    margin-bottom: calc(var(--u) * 1.5);
  }
  .side-list .meta {
    display: block;
  }
  @media (max-width: 1199px) {
    .side {
      grid-column: 1;
      border-top: 1px solid var(--rule);
      margin-top: calc(var(--u) * 6);
      padding-top: calc(var(--u) * 2);
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 0 var(--gutter);
    }
  }
</style>
