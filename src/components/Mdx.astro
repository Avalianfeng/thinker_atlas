---
import { render } from 'astro:content';
import Block from './Block.astro';
import Quote from './Quote.astro';
import Note from './Note.astro';
import Sidenote from './Sidenote.astro';
import Todo from './Todo.astro';
import Dialogue from './Dialogue.astro';
import Say from './Say.astro';
import Prop from './Prop.astro';
import SBNote from './SBNote.astro';

interface Props {
  entry: any;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Content components={{ Block, Quote, Note, Sidenote, Todo, Dialogue, Say, Prop, SBNote }} />
