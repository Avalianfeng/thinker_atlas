---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/print.css';
import Pagefind from '../components/Pagefind.astro';

interface Props {
  title: string;
  description?: string;
  accent?: string;
  bodyClass?: string;
}
const { title, description = '私人思想展馆', accent, bodyClass } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <title>{title} · 思想者图谱</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (() => {
        const t = localStorage.getItem('atlas:theme');
        const d = t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = d ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body class={bodyClass} style={accent ? `--accent:${accent}` : undefined}>
    <a class="sr-only" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="inner">
        <a class="site-title" href="/">思想者图谱</a>
        <button
          class="theme-toggle"
          id="tg-theme"
          type="button"
          aria-label="切换到暗色"
          aria-pressed="false"
        >
          <span class="theme-icon" aria-hidden="true">☾</span>
        </button>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="inner">
        <Pagefind />
      </div>
    </footer>
    <script>
      import '../scripts/toggles';
    </script>
  </body>
</html>
