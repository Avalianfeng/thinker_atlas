---
import type { Atlas } from '../lib/atlas';
interface Props {
  concept: any;
  atlas: Atlas;
}
const { concept, atlas } = Astro.props;
const d = concept.data;
const period = atlas.thinker(`atlas:${concept.id.split('/')[0].split(':')[1]}`).data.periods.find((p: any) => p.id === d.period);
---
<dl class="concept-card">
  <div class="def">
    <dt>一句话定义</dt>
    <dd style="margin:0">{d.definition}</dd>
  </div>
  <div>
    <dt>它要回答的问题</dt>
    {d.questions.length ? <ul>{d.questions.map((q: string) => <li>{q}</li>)}</ul> : <span class="todo-inline">待写</span>}
  </div>
  <div>
    <dt>所属时期</dt>
    {period ? <span>{period.label}（<span class="num">{period.from}—{period.to}</span>）</span> : <span class="todo-inline">待定</span>}
  </div>
  <div>
    <dt>关联作品</dt>
    {d.works.length ? <ul>{d.works.map((w: string) => <li><a href={atlas.ref(w).url}>{atlas.ref(w).title}</a></li>)}</ul> : <span class="todo-inline">待补</span>}
  </div>
  <div>
    <dt>原文术语</dt>
    {d.terms?.length ? <ul>{d.terms.map((t: any) => <li><span lang={t.lang || 'de'}>{t.original}</span>{t.zh !== d.title ? `（${t.zh}）` : ''}</li>)}</ul> : <span class="todo-inline">待补</span>}
  </div>
</dl>
